{
  "name": "within-Limits",
  "version": "1.0.0",
  "description": "IoT P2P device tracking backend",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:local": "node src/scripts/testLocal.js",
    "tracking:provision": "node src/scripts/provisionReporter.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "admin:dev": "npm --prefix admin-web run dev",
    "admin:build": "npm --prefix admin-web run build",
    "admin:set-role": "node src/scripts/setAdminRole.js",
    "migrate:mongo": "node src/scripts/migrateMongoToPostgres.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
