# Leave blank for local development: uses Metro's LAN host on phones and the web page's host.
# For a separate backend, Expo tunnel, or release build, set the reachable HTTPS API URL.
EXPO_PUBLIC_API_URL=
# Only the preview-local/development build profiles enable an editable laptop backend.
# Hosted preview/production builds require a public HTTPS API URL.
EXPO_PUBLIC_LOCAL_BACKEND=false
# Optional hosted web login callback, e.g. https://app.example.com/sign-in.
# Authorize its hostname in Firebase Authentication. Local development uses Metro's web page.
EXPO_PUBLIC_AUTH_RETURN_URL=
# OAuth client of type Web application, from the SAME Firebase project as the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reverse the iOS client ID: com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=
# Set these to the application IDs registered in your Firebase / Google project.
ANDROID_PACKAGE=
IOS_BUNDLE_IDENTIFIER=
