# Local backend development settings. Copy to backend/.env and fill in private values.
DATABASE_URL=postgresql://within_limits_app:replace_me@localhost:5432/within_limits
PORT=5000

# Firebase Web app configuration. The Web API key is public configuration.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_APP_ID=your-firebase-web-app-id

# Backend-only credentials: use either this base64 JSON value or ADC via
# GOOGLE_APPLICATION_CREDENTIALS. Never put service account credentials in mobile/admin-web.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=

# Keep the legacy MongoDB URI only while copying existing records to PostgreSQL.
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/within_limits
